# development: CORS sadece localhost:3000 ve 127.0.0.1:3000 için açık.
# production veya test: CORS middleware kapalı.
APP_ENV=development
# Virgülle ayrılmış, wildcard içermeyen development frontend origin'leri.
CORS_ALLOWED_ORIGINS_RAW=http://localhost:3000,http://127.0.0.1:3000
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=yasam-kodu-development/0.1 (development@localhost)
GEOCODING_TIMEOUT_SECONDS=5
# Backend only. Empty credentials/model disable interpretation until explicitly configured.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
# NVIDIA NIM is an optional second backend-only interpretation provider.
NVIDIA_API_KEY=
NVIDIA_MODEL=openai/gpt-oss-20b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Groq is an optional hosted backend-only interpretation provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Host backend: localhost. Docker Desktop backend: host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT_SECONDS=120
